<%- include('../partials/dash-open') %>
<div class="content-head"><h2>Manage Students</h2><p>Add students with their official admission number.</p></div>
<div class="grid-2">
  <div class="card">
    <div class="section-label">Add Student</div>
    <form method="POST" action="/admin/students">
      <div class="field"><label>Admission Number</label><input name="admissionNo" class="mono" placeholder="M01004" style="text-transform:uppercase;"></div>
      <div class="hint" style="margin-top:-10px; margin-bottom:14px;">Must start with M0, e.g. M01004</div>
      <div class="field"><label>Full Name</label><input name="name" placeholder="Student name"></div>
      <div class="field"><label>Class</label><input name="class" type="text" placeholder="e.g. 11th Commerce, 11th Science A"></div>
      <button class="btn" type="submit">Add Student</button>
      <% if (error) { %><div class="err-msg"><%= error %></div><% } %>
    </form>
  </div>
  <div class="card">
    <div class="section-label">All Students (<%= list.length %>)</div>
    <div style="max-height:420px; overflow-y:auto;">
    <% if (!list.length) { %>
      <div class="empty-state">No students added yet.</div>
    <% } else { %>
      <table>
        <tr><th>Adm. No.</th><th>Name</th><th>Class</th><th></th></tr>
        <% list.forEach(function(s){ %>
          <tr>
            <td class="mono"><%= s.admission_no %></td><td><%= s.name %></td><td><%= s.class %></td>
            <td>
              <form method="POST" action="/admin/students/<%= s.admission_no %>/delete" data-confirm="Remove <%= s.name %> (<%= s.admission_no %>)?">
                <button class="btn-outline btn-sm" type="submit">Remove</button>
              </form>
            </td>
          </tr>
        <% }); %>
      </table>
    <% } %>
    </div>
  </div>
</div>
<%- include('../partials/dash-close') %>
