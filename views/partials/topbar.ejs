<div class="topbar">
  <div class="brand"><div class="brand-mark">ES</div><span class="gold-text">EduSync AI</span></div>
  <% if (typeof user !== 'undefined' && user) { %>
    <div class="topbar-right">
      <span class="role-chip"><%= user.role.charAt(0).toUpperCase() + user.role.slice(1) %></span>
      <span class="user-name"><%= user.name %><% if (user.admissionNo) { %> &middot; <span class="mono"><%= user.admissionNo %></span><% } %></span>
      <form method="POST" action="/logout" style="display:inline;">
        <button class="btn-logout" type="submit">Log out</button>
      </form>
    </div>
  <% } else { %>
    <div class="topbar-right"><span class="hint" style="margin:0;">School Expo Demo</span></div>
  <% } %>
</div>
