<% if (!announcements.length) { %>
  <div class="empty-state">No announcements yet.</div>
<% } else { announcements.forEach(function(a){ %>
  <div class="list-item">
    <div class="list-item-head"><span class="list-item-title"><%= a.title %></span><span class="list-item-meta"><%= fmtDate(a.date) %></span></div>
    <div class="list-item-body"><%= a.text %></div>
    <div class="list-item-meta" style="margin-top:6px;">Posted by <%= a.by_name %></div>
  </div>
<% }); } %>
