<%
  var maxVal = 1;
  pairs.forEach(function(p){ if (p[1] > maxVal) maxVal = p[1]; });
%>
<div class="bar-chart">
  <% pairs.forEach(function(p){ var lbl = p[0], val = p[1]; var h = val === 0 ? 2 : Math.max(6, (val / maxVal) * 130); %>
    <div class="bar-col">
      <div class="bar-val"><%= val %></div>
      <div class="bar" style="height:<%= h %>px;"></div>
      <div class="bar-lbl"><%= lbl %></div>
    </div>
  <% }); %>
</div>
