<%- include('../partials/dash-open') %>
<div class="content-head"><h2>Complaint Box</h2><p>Raise a concern with the school.</p></div>
<div class="grid-2">
  <div class="card">
    <div class="section-label">New Complaint</div>
    <form method="POST" action="/student/complaints">
      <div class="field"><label>Category</label>
        <select name="category"><option>Facilities</option><option>Teacher Conduct</option><option>Bullying</option><option>Other</option></select>
      </div>
      <div class="field"><label>Details</label><textarea name="text" placeholder="Describe your complaint..."></textarea></div>
      <button class="btn" type="submit">Submit Complaint</button>
      <% if (error) { %><div class="err-msg"><%= error %></div><% } %>
      <% if (ok) { %><div class="ok-msg"><%= ok %></div><% } %>
    </form>
  </div>
  <div class="card">
    <div class="section-label">My Complaints</div>
    <% if (!rows.length) { %>
      <div class="empty-state">No complaints filed.</div>
    <% } else { rows.forEach(function(c){ %>
      <div class="list-item">
        <div class="list-item-head"><span class="list-item-title"><%= c.category %></span><span class="list-item-meta"><%= fmtDate(c.date) %></span></div>
        <div class="list-item-body"><%= c.text %></div>
      </div>
    <% }); } %>
  </div>
</div>
<%- include('../partials/dash-close') %>
