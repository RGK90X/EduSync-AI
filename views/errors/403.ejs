<%- include('../partials/head', { title: 'Access Denied' }) %>
<%- include('../partials/topbar') %>
<div class="error-stage fade-in">
  <div>
    <h1 class="gold-text">403</h1>
    <p>You don't have access to this page for your current role.</p>
    <a class="btn" style="width:auto; display:inline-flex;" href="<%= typeof user !== 'undefined' && user ? (user.role === 'student' ? '/student' : user.role === 'admin' ? '/admin' : '/staff/attendance') : '/' %>">Go back</a>
  </div>
</div>
<%- include('../partials/foot') %>
