<%- include('../partials/dash-open') %>
<div class="content-head"><h2>Exam Syllabus</h2><p>Upload syllabus coverage for an upcoming exam.</p></div>
<div class="grid-2">
  <div class="card">
    <div class="section-label">New Syllabus Entry</div>
    <form method="POST" action="/staff/syllabus">
      <div class="field"><label>Exam Name</label><input name="examName" placeholder="e.g. Mid-Term Exam"></div>
      <div class="field"><label>Subject</label><input name="subject" placeholder="e.g. Science"></div>
      <div class="field"><label>Coverage</label><textarea name="content" placeholder="Chapters / topics covered..."></textarea></div>
      <button class="btn" type="submit">Post Syllabus</button>
      <% if (error) { %><div class="err-msg"><%= error %></div><% } %>
      <% if (ok) { %><div class="ok-msg"><%= ok %></div><% } %>
    </form>
  </div>
  <div class="card">
    <div class="section-label">All Syllabus Entries</div>
    <% if (!rows.length) { %>
      <div class="empty-state">No syllabus uploaded yet.</div>
    <% } else { rows.forEach(function(s){ %>
      <div class="list-item">
        <div class="list-item-head"><span class="list-item-title"><%= s.exam_name %> &mdash; <%= s.subject %></span><span class="list-item-meta"><%= fmtDate(s.date) %></span></div>
        <div class="list-item-body"><%= s.content %></div>
      </div>
    <% }); } %>
  </div>
</div>
<%- include('../partials/dash-close') %>
