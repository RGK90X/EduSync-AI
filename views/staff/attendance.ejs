<%- include('../partials/dash-open') %>
<div class="content-head"><h2>Mark Attendance</h2><p>Select class and date, then mark each student.</p></div>
<% if (!classes.length) { %>
  <div class="card"><div class="empty-state">No classes yet — ask Admin to add a student to create your first class.</div></div>
<% } else { %>
<div class="card">
  <form method="GET" action="/staff/attendance" id="att-picker-form">
    <div class="grid-2" style="margin-bottom:18px;">
      <div class="field" style="margin:0;"><label>Class</label>
        <select name="class" onchange="document.getElementById('att-picker-form').submit()">
          <% classes.forEach(function(c){ %><option value="<%= c %>" <%= c === cls ? 'selected' : '' %>><%= c %></option><% }); %>
        </select>
      </div>
      <div class="field" style="margin:0;"><label>Date</label><input type="date" name="date" value="<%= date %>" onchange="document.getElementById('att-picker-form').submit()"></div>
    </div>
  </form>
  <% if (!roster.length) { %>
    <div class="empty-state">No students in this class yet.</div>
  <% } else { %>
  <form method="POST" action="/staff/attendance">
    <input type="hidden" name="class" value="<%= cls %>">
    <input type="hidden" name="date" value="<%= date %>">
    <table>
      <tr><th>Admission No.</th><th>Name</th><th>Status</th></tr>
      <% roster.forEach(function(s){ var current = marks[s.admission_no] || 'present'; %>
        <tr>
          <td class="mono"><%= s.admission_no %></td><td><%= s.name %></td>
          <td>
            <select name="marks[<%= s.admission_no %>]">
              <option value="present" <%= current === 'present' ? 'selected' : '' %>>Present</option>
              <option value="absent" <%= current === 'absent' ? 'selected' : '' %>>Absent</option>
              <option value="late" <%= current === 'late' ? 'selected' : '' %>>Late</option>
            </select>
          </td>
        </tr>
      <% }); %>
    </table>
    <button class="btn btn-sm" type="submit" style="margin-top:16px;">Save Attendance</button>
    <% if (ok) { %><div class="ok-msg">Attendance saved.</div><% } %>
  </form>
  <% } %>
</div>
<% } %>
<%- include('../partials/dash-close') %>
